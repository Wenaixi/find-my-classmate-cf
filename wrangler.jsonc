// Workers 部署配置。既是 cloudflareTest 的入口与绑定来源，也是 deploy.yml 实际
// 上传的那份配置——因此这里的每个字段同时是「测试事实」与「生产事实」。
//
// 字段取舍：
// - main 指向 worker 装配层；cloudflareTest 未显式给 main 时从这里取。
// - compatibility_date 写当日。迁移期不钉旧日期：本仓没有依赖旧兼容行为的代码，
//   钉一个更早的日期只会让 nodejs_compat 之类的默认行为退回旧形态。
// - kv_namespaces 只声明 binding，不写 id。id 是账号内的资源标识，写死它会把
//   「哪个账号部署」绑进仓库；本地 workerd 用 miniflare 的内存 KV 模拟，测试
//   与本地开发都不需要它。实测：删掉 id 后 `deploy --dry-run` 通过，绑定
//   metadata 里落成 type: "inherit"。
//
//   自动供给的真实行为（官方文档与 changelog 2025-10-24 的措辞很关键，不要
//   按「首次 deploy 一定回写 id」去理解）：
//     - 本地跑 `wrangler deploy`：资源按 binding 名创建，并把 id **回写进本文件**；
//     - 从 dashboard / GitHub Actions 部署：资源照样创建，但 id 只留在 dashboard，
//       **不会回写仓库**。官方原话是「即便不把资源 id 加进配置文件，资源在后续
//       部署之间仍保持关联」——所以 CI 路径不会每次都新建一个 namespace；
//       workers-sdk 有过「Builds 下自动供给非幂等」的 issue（#14284），
//       本机的 wrangler 4.163.0 未验证该修复是否覆盖这条路径。
//   因此首次部署**建议在本地跑** `npx wrangler deploy`，把回写的 id 提交进仓库：
//   那一步之后 id 就是仓库里的显式事实，CI 与本地都读同一份，不依赖自动供给的
//   跨部署关联行为。若首次就走 CI，也能跑通（同上「仍保持关联」），但仓库里
//   永远不会出现 id，排查「绑定指向哪个 namespace」时只能去 dashboard 看。
// - ratelimits 的 namespace_id 是账号内唯一的整数标识，取值 1001 是固定的
//   「这个 binding 占哪个命名空间」声明，不需要与任何远端资源对应，因此可以
//   直接进仓库（与 KV 的 id 不同：KV id 指向一个已创建的资源，rate limit
//   namespace 只由这个名字标识）。limit/period 取 Go 端的同形语义：突发容量
//   60、窗口 60 秒（server/config.go 的 rateCapacity=60、rateInterval=1s，Go
//   是令牌桶匀速回补，Workers 的 simple 只有固定窗口，此处取「每分钟 60 次」
//   这一与 Go 突发容量对齐的口径）。period 只接受 10 或 60（wrangler schema
//   的枚举），写别的值在配置校验期即失败。
// - assets 的 directory 指向构建产物实际目录：vite 的 build.outDir 就是 dist，
//   两处必须同名（wrangler-config.test.ts 有一条用例把这两个字段钉在一起）。
//   迁移完成后，原 Go 侧内嵌的 server/web 已随 Go 一并删除，dist 是唯一产物目录。
//
// - assets 的 run_worker_first 必须为 true，这不是可选项：
//
//   平台默认行为是「请求命中静态文件时直接由 Asset Worker 服务，不调用 Worker
//   脚本」。那样 /、/assets/*、/fonts/*、/favicon.png 全部绕过本 Worker，
//   于是三类本任务明确承诺的行为同时失效——六条安全头不铺（资产层只给
//   Content-Type / Cache-Control / ETag，没有 CSP、X-Frame-Options）、
//   公共限流不生效、访问日志不写。Go 基线里 securityHeaders 与 rateLimit 对
//   所有路径都生效，只有 true 能保住这条。
//
//   用 true 而不是 ["/api/*"]：白名单形态会让静态资源继续绕过 Worker，与
//   「其余请求交给 env.ASSETS.fetch 分流」的设计不同形，也把限流与安全头
//   重新变成 API 专属。
//
//   注意这条自测不出来：SELF.fetch 直接代理到默认导出的 fetch，天然绕过
//   assets 路由层。因此 wrangler-config.test.ts 里另有一条读本文件、断言
//   run_worker_first === true 的配置用例（见「部署配置契约」一组）。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "find-my-classmate-cf",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-17",
  "kv_namespaces": [
    {
      "binding": "ROSTER"
    }
  ],
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // 兜底页：资产目录内没有对应文件时由平台回 index.html。
    // 这条是前端单页形态的部署前提：当成单页应用部署后，任意未知**页面**路径
    // 都拿到首页 HTML（状态 200），而不是资产层的空体 404。
    //
    // 但它对构建产物路径是错的，装配层必须改回来：/assets/ 与 /fonts/ 下只放
    // 哈希命名文件，不存在「客户端路由」用法，那里拿到 HTML 只意味着文件缺失。
    // 因此 index.ts 的 dispatch 在交给资产层之后，把这两个前缀上的 text/html
    // 响应改写成 404（并携 no-store）——Go 的 web.go 对缺失构建产物也正是
    // 404 且不带长缓存。没有这层改写，缺失的 .js 会以 200 HTML 返回并被装配层
    // 判为「存在」，进而打上一年 immutable，客户端把一段 HTML 缓存成 .js。
    // 对应断言在 index.test.ts（页面路由拿到首页 / 产物路径仍答 404 两条）。
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    "VERSION": "dev"
  },
  // secrets.required 只声明「这个 Worker 需要名为 ADMIN_TOKEN 的 secret」，
  // 不含任何明文值。它的作用有两个：一是让类型生成不再靠 .dev.vars/进程环境
  // 推断绑定（绑定名单因此有唯一事实源），二是本地 dev 时缺该 secret 会给出
  // 明确告警，而不是等到运行时读成空串。
  //
  // 值与名字要分清：进仓库的是名字，值是 `wrangler secret put ADMIN_TOKEN`
  // 或 deploy.yml 的 secrets 上下文供给的。
  "secrets": {
    "required": [
      "ADMIN_TOKEN"
    ]
  }
}
